{
  "rules": {
    "circle_by_code": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "circles": {
      "$circleId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "circle_live": {
      "$circleId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['atMs', 'shareOn']) && newData.child('atMs').isNumber()"
        }
      }
    },
    "devices": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'ravipotdarai@gmail.com')",
        "$deviceId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['fcmToken', 'updatedAtMs']) && newData.child('updatedAtMs').isNumber() && newData.child('fcmToken').isString()"
        }
      }
    },
    "device_config": {
      ".indexOn": ["updatedAtMs", "source"],
      ".read": "auth != null && auth.token.email == 'ravipotdarai@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'ravipotdarai@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'ravipotdarai@gmail.com')",
        ".validate": "newData.hasChildren(['updatedAtMs']) && newData.child('updatedAtMs').isNumber() && !newData.hasChild('lat') && !newData.hasChild('lng') && !newData.hasChild('address') && !newData.hasChild('timeline') && !newData.hasChild('selfie') && !newData.hasChild('selfies')",
        "emergencyIntervalMinutes": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)"
        },
        "syncFrequencyMinutes": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1)"
        }
      }
    },
    "admin_audit": {
      ".read": "auth != null && auth.token.email == 'ravipotdarai@gmail.com'",
      ".write": "auth != null && auth.token.email == 'ravipotdarai@gmail.com'",
      "$id": {
        ".validate": "newData.hasChildren(['atMs', 'actorEmail', 'actorUid', 'action', 'targetUid']) && newData.child('atMs').isNumber() && !newData.hasChild('lat') && !newData.hasChild('lng') && !newData.hasChild('timeline') && !newData.hasChild('selfie') && !newData.hasChild('selfies')"
      }
    },
    "device_live": {
      ".read": false,
      ".write": false
    },
    "event_feed": {
      ".read": false,
      ".write": false
    }
  }
}
